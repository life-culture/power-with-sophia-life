          "id": "blk_81dcdkcc6e",
          "type": "component/pw2-measures",
          "v": 1,
          "fields": {
            "closing": "Read it through once. Then return to the principles one at a time.",
            "ground": "bone",
            "headline": "Four parts. Ten principles.",
            "intro": "Parts One and Two are the diagnosis. Parts Three and Four are the practice.",
            "items": [
              {
                "text": "Part One examines the drive for power, where it comes from and how it takes hold."
              },
              {
                "text": "Part Two makes the case that the strength of your relationships is the most accurate measure of success."
              },
              {
                "text": "Part Three gives the ten relational principles that make power with possible in daily life."
              },
              {
                "text": "Part Four extends these capacities into leadership, organizations and the systems you are responsible for."
              }
            ],
            "kicker": "Inside the book"
          }
        }
      ]
    },
